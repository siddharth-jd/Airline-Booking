DB_HOST=localhost
DB_PORT=5432
DB_NAME=notifications_db
DB_USER=notifications_svc
DB_PASSWORD=change_me

KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=booking-events

# A SEPARATE consumer group from the flights service. Same topic, independent
# offsets — this is the property that made Kafka the right choice over a queue.
KAFKA_CONSUMER_GROUP=notifications
